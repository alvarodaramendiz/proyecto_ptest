<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="autopartes.vista.PrincipalController" styleClass="fondo-app">

    <!-- Menú lateral -->
    <left>
        <VBox spacing="6" prefWidth="230" styleClass="menu-lateral">
            <padding><Insets top="24" right="14" bottom="20" left="14"/></padding>
            <Label text="ORIGEN" styleClass="logo-menu"/>
            <Label text="Portal de Repuestos" styleClass="subtitulo-menu"/>
            <Region prefHeight="18"/>

            <Button fx:id="btnInicio" text="Inicio" onAction="#irInicio" styleClass="menu-boton" maxWidth="Infinity"/>
            <Button fx:id="btnCatalogo" text="Catálogo" onAction="#irCatalogo" styleClass="menu-boton" maxWidth="Infinity"/>
            <Button fx:id="btnComparador" text="Comparador" onAction="#irComparador" styleClass="menu-boton" maxWidth="Infinity"/>
            <Button fx:id="btnSocios" text="Socios" onAction="#irSocios" styleClass="menu-boton" maxWidth="Infinity"/>
            <Button fx:id="btnMiCuenta" text="Mi cuenta" onAction="#irMiCuenta" styleClass="menu-boton" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator styleClass="menu-separador"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion" styleClass="menu-boton" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- Contenido: aquí se cargan las vistas de cada módulo -->
    <center>
        <StackPane fx:id="contenido">
            <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
        </StackPane>
    </center>
</BorderPane>
